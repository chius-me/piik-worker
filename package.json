{
  "name": "piik-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "cf dev",
    "build": "cf build && node scripts/check-build.mjs",
    "deploy": "cf deploy",
    "typegen": "cf workers types",
    "typecheck": "npm run typegen && tsc --noEmit && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run && vitest run --config vitest.client.config.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "overrides": {
    "zod": "$zod",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@msw/cloudflare": "^0.0.1",
    "@types/node": "^26.0.0",
    "cf": "1.0.0-beta.21",
    "msw": "^2.15.0",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
